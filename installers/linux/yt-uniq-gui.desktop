[Desktop Entry]
Type=Application
Name=yt-uniquifier
GenericName=Video re-encoder
Comment=Production-grade re-encoder with controlled micro-transforms for owned/licensed video.
Exec=yt-uniq-gui %F
Icon=yt-uniq-gui
Terminal=false
Categories=AudioVideo;Video;AudioVideoEditing;
MimeType=video/mp4;video/x-matroska;video/quicktime;video/x-msvideo;video/webm;
StartupNotify=true
Keywords=video;ffmpeg;reencode;youtube;
