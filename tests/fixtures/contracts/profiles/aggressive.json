{
  "audio_tracks": "first",
  "description": "Experimental high-change preset for authorized content that tolerates visible processing. Not a quality-first default and carries no VMAF guarantee.",
  "keep_hdr": false,
  "name": "aggressive",
  "output_container": "mp4",
  "seed": 42,
  "seed_strategy": "per_run",
  "segmentation": {
    "mode": "keyframe",
    "scene_min_length_sec": 2.0,
    "scene_threshold": 27.0
  },
  "skip_watermark_check": false,
  "target_codec": "h264",
  "target_loudness_lufs": -14.0,
  "target_vmaf": null,
  "target_vmaf_max_retries": 2,
  "target_vmaf_step": 2,
  "transforms": [
    {
      "enabled": true,
      "id": "video.crop_resize",
      "params": {
        "max_strength": 0.04,
        "rng_seed": 42
      }
    },
    {
      "enabled": true,
      "id": "video.color_eq",
      "params": {
        "brightness": 0.02,
        "contrast": 1.03,
        "gamma": 0.99,
        "saturation": 1.05
      }
    },
    {
      "enabled": true,
      "id": "video.noise",
      "params": {
        "strength": 8
      }
    },
    {
      "enabled": true,
      "id": "video.rotate",
      "params": {
        "degrees": 0.2
      }
    },
    {
      "enabled": true,
      "id": "audio.pitch_tempo",
      "params": {
        "pitch": 1.0015,
        "tempo": 1.0
      }
    },
    {
      "enabled": true,
      "id": "audio.eq",
      "params": {
        "bands": [
          [
            110.0,
            -0.9
          ],
          [
            3800.0,
            0.6
          ]
        ]
      }
    },
    {
      "enabled": true,
      "id": "audio.loudnorm",
      "params": {}
    }
  ]
}
