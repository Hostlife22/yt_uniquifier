{
  "$defs": {
    "HDRInfo": {
      "description": "Color characteristics of a video stream.",
      "properties": {
        "bit_depth": {
          "default": 8,
          "title": "Bit Depth",
          "type": "integer"
        },
        "color_range": {
          "default": "unknown",
          "enum": [
            "tv",
            "pc",
            "unknown"
          ],
          "title": "Color Range",
          "type": "string"
        },
        "is_hdr": {
          "title": "Is Hdr",
          "type": "boolean"
        },
        "primaries": {
          "default": "unknown",
          "enum": [
            "bt709",
            "bt2020",
            "bt470bg",
            "smpte170m",
            "smpte432",
            "unknown"
          ],
          "title": "Primaries",
          "type": "string"
        },
        "space": {
          "default": "unknown",
          "enum": [
            "bt709",
            "bt2020nc",
            "bt2020c",
            "bt470bg",
            "smpte170m",
            "unknown"
          ],
          "title": "Space",
          "type": "string"
        },
        "transfer": {
          "default": "unknown",
          "enum": [
            "bt709",
            "smpte2084",
            "arib-std-b67",
            "bt470bg",
            "smpte170m",
            "iec61966-2-1",
            "unknown"
          ],
          "title": "Transfer",
          "type": "string"
        }
      },
      "required": [
        "is_hdr"
      ],
      "title": "HDRInfo",
      "type": "object"
    }
  },
  "description": "One video stream in the source container.",
  "properties": {
    "bit_rate": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Bit Rate"
    },
    "codec": {
      "title": "Codec",
      "type": "string"
    },
    "color": {
      "$ref": "#/$defs/HDRInfo"
    },
    "duration_sec": {
      "title": "Duration Sec",
      "type": "number"
    },
    "fps": {
      "title": "Fps",
      "type": "number"
    },
    "height": {
      "title": "Height",
      "type": "integer"
    },
    "index": {
      "title": "Index",
      "type": "integer"
    },
    "is_default": {
      "default": false,
      "title": "Is Default",
      "type": "boolean"
    },
    "pix_fmt": {
      "title": "Pix Fmt",
      "type": "string"
    },
    "width": {
      "title": "Width",
      "type": "integer"
    }
  },
  "required": [
    "index",
    "codec",
    "width",
    "height",
    "fps",
    "duration_sec",
    "pix_fmt",
    "color"
  ],
  "title": "VideoStream",
  "type": "object"
}
