{
  "audio_tracks": "first",
  "description": "HDR (PQ / HLG) preserved through color transforms via zscale linear roundtrip.\nRequires an HDR-capable encoder (libx265 / hevc_nvenc / hevc_videotoolbox)\nand ffmpeg built with zimg.\n",
  "keep_hdr": true,
  "name": "medium_hdr",
  "output_container": "mp4",
  "seed": 42,
  "seed_strategy": "per_run",
  "segmentation": {
    "mode": "keyframe",
    "scene_min_length_sec": 2.0,
    "scene_threshold": 27.0
  },
  "target_codec": "hevc",
  "target_loudness_lufs": -14.0,
  "target_vmaf": null,
  "target_vmaf_max_retries": 2,
  "target_vmaf_step": 2,
  "transforms": [
    {
      "enabled": true,
      "id": "video.crop_resize",
      "params": {
        "max_strength": 0.025,
        "rng_seed": 42
      }
    },
    {
      "enabled": true,
      "id": "video.color_eq",
      "params": {
        "brightness": 0.008,
        "contrast": 1.012,
        "gamma": 0.997,
        "saturation": 1.02
      }
    },
    {
      "enabled": true,
      "id": "video.noise",
      "params": {
        "strength": 3
      }
    },
    {
      "enabled": true,
      "id": "audio.pitch_tempo",
      "params": {
        "pitch": 1.0008,
        "tempo": 1.0
      }
    },
    {
      "enabled": true,
      "id": "audio.eq",
      "params": {}
    },
    {
      "enabled": true,
      "id": "audio.loudnorm",
      "params": {}
    }
  ]
}
