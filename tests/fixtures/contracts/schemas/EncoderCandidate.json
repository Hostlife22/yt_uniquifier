        "h264",
        "hevc",
        "av1"
      ],
      "title": "Codec",
      "type": "string"
    },
    "error": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error"
    },
    "max_parallel": {
      "default": 1,
      "maximum": 64,
