{
  "$defs": {
    "QARegistration": {
      "additionalProperties": false,
      "description": "Provenance and per-domain evidence for registered QA metrics.",
      "properties": {
        "audio": {
          "anyOf": [
            {
              "$ref": "#/$defs/QARegistrationDetail"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "plan_hash": {
          "title": "Plan Hash",
          "type": "string"
        },
        "reference_mode": {
          "const": "plan_transformed",
          "title": "Reference Mode",
          "type": "string"
        },
        "run_seed": {
          "title": "Run Seed",
          "type": "integer"
        },
        "video": {
          "anyOf": [
            {
              "$ref": "#/$defs/QARegistrationDetail"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "reference_mode",
        "plan_hash",
        "run_seed"
      ],
      "title": "QARegistration",
      "type": "object"
    },
    "QARegistrationDetail": {
      "additionalProperties": false,
      "description": "Bounded alignment evidence for one registered QA media domain.",
      "properties": {
        "compared_samples": {
          "minimum": 0,
          "title": "Compared Samples",
          "type": "integer"
        },
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "coverage_ratio": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Coverage Ratio",
          "type": "number"
        },
        "drift_sec_per_hour": {
          "anyOf": [
            {
              "maximum": 3600.0,
              "minimum": -3600.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Drift Sec Per Hour"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        },
        "offset_sec": {
          "anyOf": [
            {
              "maximum": 30.0,
              "minimum": -30.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Offset Sec"
        }
      },
      "required": [
        "compared_samples",
        "coverage_ratio",
        "confidence"
      ],
      "title": "QARegistrationDetail",
      "type": "object"
    }
  },
  "description": "Aggregated QA metrics for one (input, output) pair.",
  "properties": {
    "audio_fp_hamming_per_frame": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Audio Fp Hamming Per Frame"
    },
    "audio_fp_hamming_per_window": {
      "anyOf": [
        {
          "items": {
            "type": "number"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Audio Fp Hamming Per Window"
    },
    "audio_fp_hamming_variance": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Audio Fp Hamming Variance"
    },
    "audio_fp_match_confidence": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Audio Fp Match Confidence"
    },
    "audio_fp_registered_hamming_per_frame": {
      "anyOf": [
        {
          "maximum": 32.0,
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Audio Fp Registered Hamming Per Frame"
    },
    "audio_fp_similarity": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Audio Fp Similarity"
    },
    "chunk_similarities": {
      "items": {
        "additionalProperties": {
          "type": "number"
        },
        "type": "object"
      },
      "title": "Chunk Similarities",
      "type": "array"
    },
    "cid_predict_self": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Cid Predict Self"
    },
    "corpus_matches": {
      "items": {
        "additionalProperties": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            }
          ]
        },
        "type": "object"
      },
      "title": "Corpus Matches",
      "type": "array"
    },
    "duration_match": {
      "title": "Duration Match",
      "type": "boolean"
    },
    "input_duration_sec": {
      "title": "Input Duration Sec",
      "type": "number"
    },
    "input_md5": {
      "title": "Input Md5",
      "type": "string"
    },
    "input_size_bytes": {
      "title": "Input Size Bytes",
      "type": "integer"
    },
    "notes": {
      "items": {
        "type": "string"
      },
      "title": "Notes",
      "type": "array"
    },
    "output_duration_sec": {
      "title": "Output Duration Sec",
      "type": "number"
    },
    "output_md5": {
      "title": "Output Md5",
      "type": "string"
    },
    "output_size_bytes": {
      "title": "Output Size Bytes",
      "type": "integer"
    },
    "phash_distance_max": {
      "title": "Phash Distance Max",
      "type": "integer"
    },
    "phash_distance_mean": {
      "title": "Phash Distance Mean",
      "type": "number"
    },
    "phash_distance_min": {
      "title": "Phash Distance Min",
      "type": "integer"
    },
    "phash_samples": {
      "title": "Phash Samples",
      "type": "integer"
    },
    "phash_similarity": {
      "title": "Phash Similarity",
      "type": "number"
    },
    "registration": {
      "anyOf": [
        {
          "$ref": "#/$defs/QARegistration"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "sscd_mean": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Sscd Mean"
    },
    "sscd_min": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Sscd Min"
    },
    "sscd_per_frame": {
      "anyOf": [
        {
          "items": {
            "type": "number"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Sscd Per Frame"
    },
    "sscd_registered_mean": {
      "anyOf": [
        {
          "maximum": 1.0,
          "minimum": -1.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Sscd Registered Mean"
    },
    "ssim_mean": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Ssim Mean"
    },
    "ssim_registered_mean": {
      "anyOf": [
        {
          "maximum": 1.0,
          "minimum": -1.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Ssim Registered Mean"
    },
    "vmaf_mean": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Vmaf Mean"
    },
    "vmaf_registered_mean": {
      "anyOf": [
        {
          "maximum": 100.0,
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Vmaf Registered Mean"
    },
    "weakest_chunk_sec": {
      "anyOf": [
        {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Weakest Chunk Sec"
    }
  },
  "required": [
    "input_md5",
    "output_md5",
    "input_size_bytes",
    "output_size_bytes",
    "input_duration_sec",
    "output_duration_sec",
    "phash_samples",
    "phash_distance_min",
    "phash_distance_mean",
    "phash_distance_max",
    "phash_similarity",
    "duration_match"
  ],
  "title": "QAReport",
  "type": "object"
}
