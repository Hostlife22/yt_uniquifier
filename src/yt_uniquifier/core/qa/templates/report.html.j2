<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>yt-uniquifier QA report</title>
  <style>
    body { font-family: -apple-system, system-ui, sans-serif; max-width: 900px;
           margin: 2em auto; padding: 0 1em; color: #222; line-height: 1.5; }
    h1 { margin-bottom: 0.2em; }
    .sub { color: #666; margin-top: 0; }
    .verdict { padding: 1em; border-radius: 6px; margin: 1em 0;
               font-size: 1.1em; }
    .verdict.green  { background: #e6f7e7; border: 1px solid #4caf50; }
    .verdict.yellow { background: #fff8e1; border: 1px solid #ffc107; }
    .verdict.red    { background: #fdecea; border: 1px solid #d32f2f; }
    .verdict.invalid { background: #f4e8ff; border: 2px solid #7b1fa2; }
    .verdict ul { margin: 0.5em 0 0; padding-left: 1.5em; }
    .axes { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 0.75em; margin: 1em 0; }
    .axis { border: 1px solid #ddd; border-radius: 6px; padding: 0.8em; }
    .axis strong { display: block; margin-bottom: 0.25em; }
    .axis p { margin: 0; color: #555; font-size: 0.9em; }
    table { width: 100%; border-collapse: collapse; margin: 1em 0; }
    th, td { padding: 0.5em 0.6em; text-align: left;
             border-bottom: 1px solid #eee; vertical-align: top; }
    th { background: #f6f6f6; width: 38%; font-weight: 600; }
    code, pre { font-family: SFMono-Regular, Menlo, monospace;
                background: #f4f4f4; padding: 0.1em 0.3em; border-radius: 3px; }
    .note { color: #b78400; font-size: 0.9em; }
    .section { margin-top: 2em; }
    .heatmap { display: flex; flex-wrap: wrap; gap: 1px;
               border: 1px solid #ddd; padding: 1px; max-width: 100%; }
    .heatmap .cell { width: 12px; height: 28px; display: inline-block;
                     cursor: help; }
    .legend { display: flex; align-items: center; gap: 8px;
              margin-top: 6px; font-size: 0.85em; color: #666; }
    .legend .swatch { display: inline-block; width: 16px; height: 12px;
                       border: 1px solid #ccc; }
  </style>
</head>
<body>

<h1>QA report</h1>
<p class="sub">yt-uniquifier · pHash / VMAF / SSIM / audio fingerprint similarity</p>

<div class="verdict {{ verdict_band }}">
  <strong>Overall output status: {{ verdict_band|upper }}</strong>
  <ul>
    {% for r in verdict_reasons %}<li>{{ r }}</li>{% endfor %}
  </ul>
</div>

<div class="axes">
  <div class="axis">
    <strong>Correctness: {{ assessment.correctness|upper }}</strong>
    <p>Stream topology, duration, declared color contract and complete decode.</p>
  </div>
  <div class="axis">
    <strong>Quality: {{ assessment.quality|upper }}</strong>
    <p>VMAF/SSIM evidence, evaluated independently from similarity.</p>
  </div>
  <div class="axis">
    <strong>Visual similarity: {{ assessment.visual_similarity|upper }}</strong>
    <p>Sampled pHash diagnostic only; it is not an external-system prediction.</p>
  </div>
</div>

<div class="section">
  <h2>Files</h2>
  <table>
    <tr><th>Input MD5</th><td><code>{{ report.input_md5 }}</code></td></tr>
    <tr><th>Output MD5</th><td><code>{{ report.output_md5 }}</code></td></tr>
    <tr><th>Input size</th><td>{{ "{:,}".format(report.input_size_bytes) }} bytes</td></tr>
    <tr><th>Output size</th><td>{{ "{:,}".format(report.output_size_bytes) }} bytes</td></tr>
    <tr><th>Input duration</th><td>{{ "%.3f"|format(report.input_duration_sec) }} s</td></tr>
    <tr><th>Output duration</th><td>{{ "%.3f"|format(report.output_duration_sec) }} s</td></tr>
    <tr><th>Duration match (±0.5s)</th><td>{{ report.duration_match }}</td></tr>
  </table>
</div>

<div class="section">
  <h2>Similarity metrics</h2>
  <table>
    <tr>
      <th>pHash similarity <small>(1.0 = identical)</small></th>
      <td>{% if report.phash_samples > 0 %}{{ "%.4f"|format(report.phash_similarity) }}
        <small>(samples: {{ report.phash_samples }},
        distance min/mean/max:
        {{ report.phash_distance_min }} /
        {{ "%.2f"|format(report.phash_distance_mean) }} /
        {{ report.phash_distance_max }})</small>
        {% else %}<em>not available</em>{% endif %}</td>
    </tr>
    <tr>
      <th>Audio fingerprint similarity</th>
      <td>{% if report.audio_fp_similarity is not none %}
        {{ "%.4f"|format(report.audio_fp_similarity) }}
      {% else %}<em>not available</em>{% endif %}</td>
    </tr>
    <tr>
      <th>Audio FP Hamming distance <small>(bits / 32-bit frame; ≥30 = high-confidence non-match)</small></th>
      <td>{% if report.audio_fp_hamming_per_frame is not none %}
        {{ "%.1f"|format(report.audio_fp_hamming_per_frame) }} bits
        {% if report.audio_fp_match_confidence is not none %}
          <small>(match confidence: {{ "%.2f"|format(report.audio_fp_match_confidence) }})</small>
        {% endif %}
      {% else %}<em>not available</em>{% endif %}</td>
    </tr>
    <tr>
      <th>VMAF <small>(0..100, higher = closer to source)</small></th>
      <td>{% if report.vmaf_mean is not none %}
        {{ "%.2f"|format(report.vmaf_mean) }}
      {% else %}<em>not available</em>{% endif %}</td>
    </tr>
    <tr>
      <th>SSIM <small>(0..1)</small></th>
      <td>{% if report.ssim_mean is not none %}
        {{ "%.4f"|format(report.ssim_mean) }}
      {% else %}<em>not available</em>{% endif %}</td>
    </tr>
  </table>
</div>

{% if plan %}
<div class="section">
  <h2>Plan</h2>
  <table>
    <tr><th>Profile</th><td><code>{{ plan.profile.name }}</code>{% if plan.profile.description %} — {{ plan.profile.description }}{% endif %}</td></tr>
    <tr><th>Encoder</th><td><code>{{ plan.encoder.name }}</code> ({{ plan.encoder.vendor }})</td></tr>
    <tr><th>plan_hash</th><td><code>{{ plan.plan_hash }}</code></td></tr>
    <tr>
      <th>Transforms</th>
      <td>
        <ul style="margin: 0; padding-left: 1.2em;">
        {% for t in plan.profile.transforms if t.enabled %}
          <li><code>{{ t.id }}</code>{% if t.params %} — {{ t.params }}{% endif %}</li>
        {% else %}
          <li><em>(none enabled)</em></li>
        {% endfor %}
        </ul>
      </td>
    </tr>
  </table>
</div>
{% endif %}

{% if report.chunk_similarities %}
<div class="section">
  <h2>Legacy chunked similarity diagnostics</h2>
  <table>
    <tr>
      <th>Weighted self-similarity heuristic</th>
      <td>
        {% if report.cid_predict_self is not none %}
          {{ "%.3f"|format(report.cid_predict_self) }}
        {% else %}<em>n/a</em>{% endif %}
      </td>
    </tr>
    <tr>
      <th>Highest-similarity chunk</th>
      <td>
        {% if report.weakest_chunk_sec %}
          {{ "%.1f"|format(report.weakest_chunk_sec[0]) }}s –
          {{ "%.1f"|format(report.weakest_chunk_sec[1]) }}s
        {% else %}<em>n/a</em>{% endif %}
      </td>
    </tr>
  </table>
  <div class="heatmap">
    {% for c in report.chunk_similarities %}
    <span class="cell" style="background: {{ c.combined|heatmap_color }}"
          title="{{ '%.1f'|format(c.start_sec) }}s–{{ '%.1f'|format(c.end_sec) }}s
combined: {{ '%.3f'|format(c.combined) }}
visual: {{ '%.3f'|format(c.visual) }}
audio: {{ '%.3f'|format(c.audio) }}"></span>
    {% endfor %}
  </div>
  <div class="legend">
    <span class="swatch" style="background: {{ 0.0|heatmap_color }}"></span> low (different)
    <span class="swatch" style="background: {{ 0.5|heatmap_color }}"></span> mid
    <span class="swatch" style="background: {{ 1.0|heatmap_color }}"></span> high (similar)
    <em style="margin-left: 1em;">informational regression signal only; not a probability or external-system prediction.</em>
  </div>
</div>
{% endif %}

{% if report.sscd_mean is not none %}
<div class="section">
  <h2>SSCD representation similarity</h2>
  <p>
    Cosine similarity of SSCD embeddings between matched source and output
    frames. SSCD is Meta's self-supervised representation model
    (<a href="https://github.com/facebookresearch/sscd-copy-detection">facebookresearch/sscd-copy-detection</a>);
    this score is retained as an internal regression diagnostic and does not
    predict the decision of any external rights-management system.
  </p>
  <table>
    <tr>
      <th>Mean similarity</th>
      <td>
        {{ "%.3f"|format(report.sscd_mean) }}
        {% if report.sscd_mean >= 0.85 %}
          <span style="font-weight:600;">high similarity</span>
        {% elif report.sscd_mean >= 0.65 %}
          <span style="font-weight:600;">moderate similarity</span>
        {% else %}
          <span style="font-weight:600;">low similarity</span>
        {% endif %}
      </td>
    </tr>
    {% if report.sscd_min is not none %}
    <tr>
      <th>Min similarity (worst frame pair)</th>
      <td>{{ "%.3f"|format(report.sscd_min) }}</td>
    </tr>
    {% endif %}
    {% if report.sscd_per_frame %}
    <tr>
      <th>Frame pairs scored</th>
      <td>{{ report.sscd_per_frame|length }}</td>
    </tr>
    {% endif %}
  </table>
  {% if report.sscd_per_frame %}
  <div class="heatmap" style="margin-top:0.5em;">
    {% for v in report.sscd_per_frame %}
    <span class="cell"
          style="background: {{ v|heatmap_color }}"
          title="frame {{ loop.index }}: {{ '%.3f'|format(v) }}"></span>
    {% endfor %}
  </div>
  <div class="legend">
    <span class="swatch" style="background: {{ 0.0|heatmap_color }}"></span> low (different)
    <span class="swatch" style="background: {{ 0.5|heatmap_color }}"></span> mid
    <span class="swatch" style="background: {{ 1.0|heatmap_color }}"></span> high (similar)
  </div>
  {% endif %}
</div>
{% endif %}

{% if report.corpus_matches %}
<div class="section">
  <h2>Corpus matches</h2>
  <p>Output is similar to these previously-indexed files (your <code>yt-uniq corpus add</code>'d uploads).</p>
  <table>
    <tr><th>entry</th><th>combined</th><th>visual</th><th>audio</th></tr>
    {% for m in report.corpus_matches %}
    <tr>
      <td><code>{{ m.path }}</code></td>
      <td>{{ "%.3f"|format(m.combined) }}</td>
      <td>{{ "%.3f"|format(m.visual) }}</td>
      <td>{{ "%.3f"|format(m.audio) }}</td>
    </tr>
    {% endfor %}
  </table>
</div>
{% endif %}

{% if report.notes %}
<div class="section">
  <h2>Notes</h2>
  <ul>
    {% for n in report.notes %}
      <li class="note">{{ n }}</li>
    {% endfor %}
  </ul>
</div>
{% endif %}

</body>
</html>
