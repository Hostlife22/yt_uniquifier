    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "vendor": {
      "enum": [
        "nvenc",
        "qsv",
        "amf",
        "videotoolbox",
        "vulkan",
        "x264",
        "x265",
        "libaom",
        "svtav1"
      ],
      "title": "Vendor",
      "type": "string"
    },
    "works": {
      "title": "Works",
      "type": "boolean"
    }
  },
  "required": [
    "name",
    "vendor",
    "codec",
    "works"
