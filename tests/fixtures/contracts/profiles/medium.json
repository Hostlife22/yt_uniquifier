      }
    },
    {
      "enabled": true,
      "id": "video.color_eq",
      "params": {
        "brightness": 0.012,
        "contrast": 1.018,
        "gamma": 0.995,
        "saturation": 1.03
      }
    },
    {
      "enabled": true,
      "id": "video.noise",
      "params": {
        "strength": 4
      }
    },
    {
      "enabled": true,
      "id": "audio.pitch_tempo",
      "params": {
        "pitch": 1.0008,
        "tempo": 1.0
      }
    },
    {
      "enabled": true,
      "id": "audio.eq",
      "params": {}
    },
    {
      "enabled": true,
      "id": "audio.loudnorm",
      "params": {}
    }
  ]
