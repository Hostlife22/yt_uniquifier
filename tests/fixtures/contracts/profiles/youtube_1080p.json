{
  "audio_tracks": "first",
  "description": "YouTube 1080p (1920x1080 16:9) re-encode with balanced micro-transforms. Default target for most upload workflows.  -14 LUFS (YouTube spec).",
  "keep_hdr": false,
  "name": "youtube_1080p",
  "output_container": "mp4",
  "seed": 42,
  "seed_strategy": "per_run",
  "segmentation": {
    "mode": "keyframe",
    "scene_min_length_sec": 2.0,
    "scene_threshold": 27.0
  },
  "skip_watermark_check": false,
  "target_codec": "h264",
  "target_loudness_lufs": -14.0,
  "target_vmaf": null,
  "target_vmaf_max_retries": 2,
  "target_vmaf_step": 2,
  "transforms": [
    {
      "enabled": true,
      "id": "video.fit_aspect",
      "params": {
        "mode": "crop",
        "target_aspect": "16:9"
      }
    },
    {
      "enabled": true,
      "id": "video.crop_resize",
      "params": {
        "max_strength": 0.02,
        "rng_seed": 42
      }
    },
    {
      "enabled": true,
      "id": "video.color_eq",
      "params": {
        "brightness": 0.008,
        "contrast": 1.015,
        "gamma": 0.997,
        "saturation": 1.02
      }
    },
    {
      "enabled": true,
      "id": "video.noise",
      "params": {
        "strength": 3
      }
    },
    {
      "enabled": true,
      "id": "audio.pitch_tempo",
      "params": {
        "pitch": 1.0006,
        "tempo": 1.0
      }
    },
    {
      "enabled": true,
      "id": "audio.eq",
      "params": {}
    },
    {
      "enabled": true,
      "id": "audio.loudnorm",
      "params": {}
    }
  ]
}
